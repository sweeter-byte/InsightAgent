# Required: OpenAI-compatible Chat Completions endpoint used for intent routing,
# direct answers, planning, grading, reporting, and self-check.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional: image ingestion and vision retrieval stay disabled unless all three
# values are configured.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Local ingestion/indexing. The embedding and reranker models may be downloaded
# by sentence-transformers on first use; pre-provision them for offline deploys.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_PATH=.data/qdrant
QDRANT_COLLECTION=insight_documents

# Controlled server-side upload storage; the API never accepts local paths.
MATERIAL_UPLOAD_DIR=.data/materials
# 20 MiB per upload.
MATERIAL_MAX_BYTES=20971520

# Required for Hybrid Retrieval. Recommended bilingual model:
# BAAI/bge-reranker-v2-m3
RERANKER_MODEL=
HYBRID_DENSE_K=20
HYBRID_SPARSE_K=20
HYBRID_RERANK_K=20
HYBRID_FINAL_TOP_K=5
HYBRID_RRF_K=60
# Optional. WEB becomes an available research source only when this is set.
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_LIMIT=5
WEB_FETCH_LIMIT=3

# SQLite path for LangGraph research checkpoints.
CHECKPOINT_PATH=.insight_agent/checkpoints.sqlite

# Single-process Research Runtime. Redis stores public run status and SSE events;
# SQLite stores LangGraph checkpoints used by resume.
RUNTIME_REDIS_URL=redis://localhost:6379/0
RUNTIME_MAX_CONCURRENCY=2
RUNTIME_RUN_TIMEOUT_SECONDS=900
RUNTIME_EVENT_TTL_SECONDS=86400
RUNTIME_INFRA_RETRY_ATTEMPTS=3
RUNTIME_INFRA_RETRY_BACKOFF_SECONDS=0.2
